# ==============================================================================
# KOK BISA? Discourse Analytics — Environment Configuration Template
# Copy this file to '.env' and fill in your credentials.
# ==============================================================================

# YouTube Data API v3 Key (Required for Stage 02 scraping)
# Obtain your key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Pipeline Execution Mode
# 0 = Use GPU/Transformer checkpoints if available
# 1 = Force fast rule-based fallback mode for quick testing
FORCE_RULE_BASED=0
